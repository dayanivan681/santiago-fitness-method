{
  "name": "fitness-app-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.presentacion.config.ts && node scripts/preparar-pwa.mjs",
    "deploy": "node scripts/deploy.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:migracion-santiago": "node scripts/pruebas-migracion-santiago.mjs",
    "test:roles": "node scripts/pruebas-roles.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "handoff:status": "node scripts/handoff-sync.mjs status",
    "handoff:sync": "node scripts/handoff-sync.mjs sync",
    "handoff:claim": "node scripts/handoff-sync.mjs claim",
    "handoff:adopt": "node scripts/handoff-sync.mjs adopt",
    "handoff:publish": "node scripts/handoff-sync.mjs publish",
    "invitar": "node scripts/invitar.mjs",
    "test:movil": "maestro test pruebas-maestro/qa-v2.yaml",
    "qa:preparar": "node scripts/preparar-qa-v2.mjs",
    "qa:servir": "node scripts/servir-qa-v2.mjs",
    "qa:acceso": "node scripts/qa-proxy.mjs",
    "test:http": "node scripts/pruebas-v2-http.mjs",
    "d1:v2": "node scripts/migrar-v2.mjs",
    "biblioteca:santiago": "node scripts/importar-biblioteca-santiago.mjs"
  },
  "dependencies": {
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "jose": "^6.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.3",
    "stripe": "^22.6.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260830.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
