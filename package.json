{
  "name": "fitness-app-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name=santiago-fitness-method",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:migracion-santiago": "node scripts/pruebas-migracion-santiago.mjs",
    "test:roles": "node scripts/pruebas-roles.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "handoff:status": "node scripts/handoff-sync.mjs status",
    "handoff:sync": "node scripts/handoff-sync.mjs sync",
    "handoff:claim": "node scripts/handoff-sync.mjs claim",
    "handoff:adopt": "node scripts/handoff-sync.mjs adopt",
    "handoff:publish": "node scripts/handoff-sync.mjs publish",
    "invitar": "node scripts/invitar.mjs",
    "d1:migrar": "wrangler d1 execute santiago-acceso --remote --file=migrations/0001_acceso.sql",
    "d1:migrar-roles": "npx wrangler d1 execute santiago-acceso --remote --file=migrations/0002_role_split.sql && npx wrangler d1 execute santiago-acceso --remote --file=migrations/0003_seed_qa_role_split.sql && npx wrangler d1 execute santiago-acceso --remote --file=migrations/0004_seed_santiago_routines.sql",
    "d1:migrar-santiago": "npx wrangler d1 execute santiago-acceso --remote --file=migrations/0004_seed_santiago_routines.sql",
    "test:movil": "node pruebas-maestro/enlace-local.mjs > /tmp/sfm-enlace.txt && maestro test pruebas-maestro/qa-movil.yaml -e ENLACE=$(cat /tmp/sfm-enlace.txt)"
  },
  "dependencies": {
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260830.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
