# Cabeceras para Cloudflare Pages.
#
# El hash del build ya está en el nombre de cada archivo de assets, así que se
# pueden cachear para siempre. El service worker y el index NO: son los que
# tienen que notar que hay una versión nueva.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/ejercicios/*
  Cache-Control: public, max-age=31536000, immutable

/fuentes/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache
