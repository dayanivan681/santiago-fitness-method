# Cabeceras para Cloudflare Pages.
#
# El hash del build ya está en el nombre de cada archivo de assets, así que se
# pueden cachear para siempre.
#
# El HTML no: es la puerta. Cada carga tiene que llegar al servidor para que
# Cloudflare Access decida si autoriza. Con `no-store` el navegador ni siquiera
# lo guarda en disco, así que no puede servir una copia vieja sin pasar por el
# login.

/
  Cache-Control: no-store

/index.html
  Cache-Control: no-store

# El service worker del shell. Si un intermediario devolviera una copia
# guardada, las instalaciones antiguas no llegarían a migrar nunca.
/sw.js
  Cache-Control: no-store, no-cache, must-revalidate

/manifest.webmanifest
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/ejercicios/*
  Cache-Control: public, max-age=31536000, immutable

/fuentes/*
  Cache-Control: public, max-age=31536000, immutable
